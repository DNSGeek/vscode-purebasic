        }
      ]
    },
    "pb-constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.purebasic",
          "match": "\\b(#True|#False|#Null|#Empty|#NUL|#LF|#CR|#TAB|#CRLF)\\b"
        }
      ]
    },
    "user-constants": {
      "name": "constant.other.purebasic",
      "match": "#[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "operators": {
      "name": "keyword.operator.purebasic",
      "match": "\\+|-|\\*|/|\\\\|%|=|<>|<=|>=|<<|>>|[<>]|!|&|\\||\\^|~|@|\\?"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.purebasic",
          "match": "\\$[0-9A-Fa-f]+"
        },
        {
          "name": "constant.numeric.binary.purebasic",
          "match": "%[01]+"
        },
        {
          "name": "constant.numeric.float.purebasic",
          "match": "\\b[0-9]+\\.[0-9]*(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.purebasic",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.purebasic",
      "match": "\\.(b|a|w|u|l|i|q|f|d|s|c|String)\\b"
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.purebasic",
          "match": "^\\s*[a-zA-Z_][a-zA-Z0-9_]*:"
        },
        {
          "name": "entity.name.label.purebasic",
          "match": "\\b(Goto|Gosub)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "2": {
              "name": "entity.name.label.purebasic"
            }
          }
        }
      ]
    },
    "procedure-call": {
      "name": "entity.name.function.purebasic",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "variables": {
      "name": "variable.other.purebasic",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
