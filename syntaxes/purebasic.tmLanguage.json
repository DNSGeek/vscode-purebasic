          "name": "support.function.web.purebasic",
          "match": "(?i)\\b(UnbindWebViewCallback|WebViewExecuteScript|BindWebViewCallback|WebViewGadget|WebViewProxy)(?=\\s*\\()"
        },
        {
          "comment": "Library functions",
          "name": "support.function.system.purebasic",
          "match": "(?i)\\b(ExamineLibraryFunctions|LibraryFunctionAddress|CountLibraryFunctions|LibraryFunctionName|NextLibraryFunction|CallCFunctionFast|CallFunctionFast|GetFunctionEntry|CallCFunction|CloseLibrary|CallFunction|GetFunction|OpenLibrary|IsLibrary|LibraryID)(?=\\s*\\()"
        },
        {
          "comment": "SerialPort functions",
