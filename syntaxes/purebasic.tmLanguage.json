{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PureBasic",
  "scopeName": "source.purebasic",
  "fileTypes": [".pb", ".pbi", ".pbf", ".pbp"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#compiler-directives"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#pb-constants"
    },
    {
      "include": "#user-constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#procedure-call"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.purebasic",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.escaped.purebasic",
          "begin": "~\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.purebasic",
              "match": "\\\\[nt\"\\\\]"
            }
          ]
        },
        {
          "name": "string.quoted.double.purebasic",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "compiler-directives": {
      "patterns": [
        {
          "name": "keyword.control.compiler.purebasic",
          "match": "(?i)\\b(CompilerIf|CompilerElseIf|CompilerElse|CompilerEndIf|CompilerSelect|CompilerCase|CompilerDefault|CompilerEndSelect|CompilerError|CompilerWarning)\\b"
        },
        {
          "name": "constant.language.compiler.purebasic",
          "match": "\\b(#PB_Compiler_OS|#PB_OS_Windows|#PB_OS_Linux|#PB_OS_MacOS|#PB_Compiler_Processor|#PB_Processor_x86|#PB_Processor_x64|#PB_Processor_arm|#PB_Processor_arm64|#PB_Compiler_Date|#PB_Compiler_File|#PB_Compiler_Line|#PB_Compiler_Version|#PB_Compiler_Home|#PB_Compiler_IsMainFile|#PB_Compiler_Thread|#PB_Compiler_Unicode|#PB_Compiler_Debugger|#PB_Compiler_Backend|#PB_Compiler_ExecutableFormat|#PB_Compiler_Optimizer)\\b"
        }
      ]
    },
    "control-flow": {
      "name": "keyword.control.purebasic",
      "match": "(?i)\\b(If|Else|ElseIf|EndIf|Select|Case|Default|EndSelect|For|To|Step|Next|ForEach|While|Wend|Repeat|Until|ForEver|Break|Continue|Goto|Gosub|Return|End|Stop|FakeReturn|Import|ImportC|EndImport|IncludeFile|XIncludeFile|IncludeBinary|IncludePath|EnableExplicit|DisableExplicit|EnableASM|DisableASM|EnableDebugger|DisableDebugger)\\b"
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.procedure.purebasic",
          "match": "(?i)\\b(Procedure|ProcedureC|ProcedureDLL|ProcedureCDLL|EndProcedure|ProcedureReturn|Declare|DeclareC|DeclareDLL|DeclareCDLL|Prototype|PrototypeC|Macro|EndMacro|Structure|EndStructure|StructureUnion|EndStructureUnion|Interface|EndInterface|Extends|Module|EndModule|DeclareModule|EndDeclareModule|UseModule|UnuseModule|Enumeration|EndEnumeration)\\b"
        },
        {
          "name": "keyword.declaration.variable.purebasic",
          "match": "(?i)\\b(Define|Dim|ReDim|Global|Protected|Static|Shared|Threaded|NewList|NewMap|FreeList|FreeMap|DataSection|EndDataSection|Data|Read|Restore|Runtime)\\b"
        },
        {
          "name": "keyword.other.purebasic",
          "match": "(?i)\\b(With|EndWith|And|Or|Not|XOr|As|Align|OffsetOf|SizeOf|TypeOf|Swap|Bool|Debug|DebugLevel|CallDebugger)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "String functions",
          "name": "support.function.string.purebasic",
          "match": "(?i)\\b(StringByteLength|UnescapeString|ReplaceString|ReverseString|EscapeString|InsertString|RemoveString|FormatNumber|CountString|StringField|FindString|LCase|LTrim|Right|RTrim|Space|UCase|Ascii|Left|LSet|RSet|StrF|StrD|StrU|Trim|ValD|ValF|UTF8|Asc|Bin|Chr|Hex|Len|Mid|Str|Val)(?=\\s*\\()"
        },
        {
          "comment": "Math functions",
          "name": "support.function.math.purebasic",
          "match": "(?i)\\b(IsInfinity|RandomData|RandomSeed|Infinity|Degree|Radian|Random|ACosH|ASinH|ATan2|ATanH|IsNaN|Log10|Round|ACos|ASin|ATan|CosH|IntQ|Sign|SinH|TanH|Abs|Cos|Exp|Int|Pow|Log|Mod|NaN|Sin|Sqr|Tan)(?=\\s*\\()"
        },
        {
          "comment": "Memory functions",
          "name": "support.function.memory.purebasic",
          "match": "(?i)\\b(CompareMemoryString|MemoryStringLength|AllocateStructure|CopyMemoryString|ReAllocateMemory|AllocateMemory|CompareMemory|FreeStructure|CopyMemory|FillMemory|FreeMemory|MemorySize|MoveMemory|PeekA|PeekB|PeekC|PeekD|PeekI|PeekL|PeekW|PeekF|PeekQ|PeekS|PeekU|PokeA|PokeB|PokeC|PokeD|PokeI|PokeL|PokeQ|PokeW|PokeF|PokeS|PokeU)(?=\\s*\\()"
